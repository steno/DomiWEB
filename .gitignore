# public/sites + public/claim + public/kits are published to GitHub Pages — track them
!public/index.html
!public/assets/**
!public/assets/**/*
public/videos/**
!public/videos/.gitkeep
!public/videos/facecam-*.mp4
!public/videos/facecam-source.png

# Scraped raw dumps
data/raw/**
!data/raw/.gitkeep
!data/raw/fixture-scrape.json

# Local video work files (mp3 intermediates)
data/videos/*
!data/videos/.gitkeep
!data/videos/*-script.txt


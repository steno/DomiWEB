*.log
.DS_Store

# Runtime data (keep folder structure via .gitkeep)
data/leads/*.json
data/leads/*.csv
data/sites/**
data/kits/**
data/menus/**
data/videos/**
data/walkthroughs/**
data/outreach/**
data/db/*.sqlite

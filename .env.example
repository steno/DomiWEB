# Apify — required for Google Maps scrape
# Get a token at https://console.apify.com/account/integrations
APIFY_TOKEN=

# Optional: override the default Google Maps actor
# APIFY_GOOGLE_MAPS_ACTOR=compass/crawler-google-places

# AI providers (Step 3+ name extraction & site generation)
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# XAI_API_KEY=

# GitHub Pages hosting
# Example: https://steno.github.io/DomiWEB
GITHUB_PAGES_BASE_URL=https://steno.github.io/DomiWEB
GITHUB_REPO=https://github.com/steno/DomiWEB

# Pretty public share link for the digital-menu product (splash / ads).
# Per-business outreach still uses the claim URL (/claim/<slug>/).
MENU_SHARE_URL=https://tinyurl.com/domenus

# Where "Reclamar mi sitio" opens WhatsApp (your number, with country code)
# Example: +18095551234 or 18095551234
# Required for claim-pages (or set CLAIM_INBOX)
CLAIM_WHATSAPP=

# Optional fallback: mailto if CLAIM_WHATSAPP is empty
CLAIM_INBOX=

# Bank transfer close kit (send-whatsapp --close, after they say yes)
TRANSFER_BANK=
TRANSFER_ACCOUNT=
TRANSFER_NAME=
# Optional: e.g. 24–48 horas
# DELIVERY_HOURS=24–48 horas

# Image / video generation (lipsync)
# Get a key at https://fal.ai/dashboard/keys
FAL_KEY=
# REPLICATE_API_TOKEN=
